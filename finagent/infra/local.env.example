FINAGENT_ENV=prod
FINAGENT_RUNTIME_MODE=production

FINAGENT_DATABASE_BACKEND=postgresql
FINAGENT_DATABASE_URL=postgresql://finagent:change-me@127.0.0.1:5432/finagent
FINAGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=10
FINAGENT_DATABASE_POOL_MIN_SIZE=1
FINAGENT_DATABASE_POOL_MAX_SIZE=10

FINAGENT_VECTOR_STORE_BACKEND=milvus
FINAGENT_MILVUS_URI=http://127.0.0.1:19530
FINAGENT_MILVUS_TOKEN=
FINAGENT_MILVUS_COLLECTION=user_memory_vectors
FINAGENT_EMBEDDING_BASE_URL=http://127.0.0.1:11434
FINAGENT_EMBEDDING_API_KEY=
FINAGENT_EMBEDDING_MODEL=nomic-embed-text
FINAGENT_EMBEDDING_DIMENSION=768

FINAGENT_GRAPH_STORE_BACKEND=neo4j
FINAGENT_NEO4J_URI=bolt://127.0.0.1:7687
FINAGENT_NEO4J_USER=neo4j
FINAGENT_NEO4J_PASSWORD=change-me
FINAGENT_NEO4J_DATABASE=neo4j
FINAGENT_NEO4J_NARRATIVE_INDEX=market_narrative_fulltext

FINAGENT_INTENT_CLASSIFIER_BACKEND=http_bert
FINAGENT_INTENT_CLASSIFIER_BASE_URL=http://127.0.0.1:8083
FINAGENT_INTENT_CLASSIFIER_API_KEY=
FINAGENT_INTENT_CLASSIFIER_MODEL=finbert-intent-lite
FINAGENT_INTENT_CLASSIFIER_TIMEOUT_SECONDS=3

FINAGENT_ORCHESTRATOR_BACKEND=langgraph
FINAGENT_TEMPORAL_TARGET_HOST=127.0.0.1:7233
FINAGENT_TEMPORAL_NAMESPACE=default
FINAGENT_TEMPORAL_TASK_QUEUE=finagent-orchestrator
FINAGENT_TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=300

FINAGENT_RAG_BACKEND=http
FINAGENT_RAG_BASE_URL=http://127.0.0.1:8082
FINAGENT_RAG_API_KEY=
FINAGENT_RAG_INDEX_NAME=research_snippets
FINAGENT_RAG_RERANK_BASE_URL=
FINAGENT_RAG_RERANK_API_KEY=
FINAGENT_RAG_RERANK_MODEL=bge-reranker-large

FINAGENT_MEMORY_RERANK_BASE_URL=
FINAGENT_MEMORY_RERANK_API_KEY=
FINAGENT_MEMORY_RERANK_MODEL=bge-reranker-large
FINAGENT_MEMORY_RERANK_TIMEOUT_SECONDS=3

FINAGENT_MARKET_DATA_PROVIDER=http
FINAGENT_MARKET_DATA_BASE_URL=http://127.0.0.1:8081
FINAGENT_MARKET_DATA_API_KEY=
FINAGENT_MARKET_DATA_SOURCES=postgres_snapshot,sec_edgar,tushare,akshare,alpha_vantage,polygon,finnhub,yahoo_finance
FINAGENT_MARKET_DATA_PRIMARY_SOURCE=postgres_snapshot
FINAGENT_MARKET_DATA_FALLBACK_SOURCE=postgres_snapshot
FINAGENT_MARKET_DATA_CACHE_TTL_SECONDS=30
FINAGENT_TUSHARE_TOKEN=
FINAGENT_AKSHARE_BASE_URL=
FINAGENT_ALPHA_VANTAGE_API_KEY=
FINAGENT_POLYGON_API_KEY=
FINAGENT_FINNHUB_API_KEY=
FINAGENT_YAHOO_FINANCE_BASE_URL=
FINAGENT_SEC_USER_AGENT=FinAgent production contact@example.com

FINAGENT_LLM_PROVIDER=ollama
FINAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
FINAGENT_OLLAMA_MODEL=qwen3.5:4b
FINAGENT_OLLAMA_TIMEOUT_SECONDS=120
FINAGENT_OLLAMA_NUM_PREDICT=768

FINAGENT_REQUEST_TIMEOUT_SECONDS=8
